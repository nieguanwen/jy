<Window x:Class="thread_burr_cleaning.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thread Burr Cleaning" Height="800" Width="1200"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Window.Background>
        <ImageBrush ImageSource="backimage.bmp" Stretch="Fill" />
    </Window.Background>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：标题 + 控制按钮 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="螺纹毛刺清洁装置"
                       HorizontalAlignment="Center"
                       FontSize="42"
                       Foreground="White"
                       Margin="0,10,0,15" />
            <WrapPanel HorizontalAlignment="Center">
                <Button x:Name="ConnectDeviceButton"
                        Content="连接设备"
                        Width="120" Height="35"
                        Click="ConnectDeviceButton_Click"
                        FontSize="16" Margin="0,0,10,0" />
                <Button x:Name="OpenCameraButton"
                        Content="打开相机"
                        Width="120" Height="35"
                        Click="OpenCameraButton_Click"
                        FontSize="16" Margin="0,0,10,0" />
                <Button x:Name="GrabImageButton"
                        Content="采集图像"
                        Width="120" Height="35"
                        Click="GrabImageButton_Click"
                        FontSize="16" Margin="0,0,10,0"
                        IsEnabled="False" />
                <Button Content="相机配置"
                        Width="120" Height="35"
                        Click="CameraConfigButton_Click"
                        FontSize="16" Margin="0,0,10,0" />
                <Button Content="通讯测试"
                        Width="120" Height="35"
                        Click="CommTestButton_Click"
                        FontSize="16" Margin="0,0,10,0" />
                <Button x:Name="OfflineTest1Button"
                        Content="离线测试1"
                        Width="120" Height="35"
                        Click="OfflineTest1Button_Click"
                        FontSize="14" Margin="0,0,10,0">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="OfflineTest1Menu"
                                     FontSize="14">
                            <MenuItem Header="加载图片文件夹"
                                      Click="LoadImageFolder1_Click"/>
                            <MenuItem Header="检测当前"
                                      Click="StartOfflineTest1_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="OfflineTest2Button"
                        Content="离线测试2"
                        Width="120" Height="35"
                        Click="OfflineTest2Button_Click"
                        FontSize="14">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="OfflineTest2Menu"
                                     FontSize="14">
                            <MenuItem Header="加载图片文件夹"
                                      Click="LoadImageFolder2_Click"/>
                            <MenuItem Header="检测当前"
                                      Click="StartOfflineTest2_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </WrapPanel>
        </StackPanel>

        <!-- 中间：图片显示区域（4 窗口） -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 算法1：相机1 原始 + 检测 -->
            <GroupBox Grid.Row="0" Grid.Column="0" Header="相机1 - 原始图像" Foreground="White"
                      BorderBrush="Gray" Margin="0,0,5,5">
                <Image x:Name="Cam1Original"
                       Stretch="Uniform"
                       Source="{x:Null}"/>
            </GroupBox>

            <GroupBox Grid.Row="0" Grid.Column="1" Header="相机1 - 算法1检测" Foreground="White"
                      BorderBrush="Gray" Margin="5,0,0,5">
                <Image x:Name="Cam1Detection"
                       Stretch="Uniform"
                       Source="{x:Null}"/>
            </GroupBox>

            <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,5">
                <Button Content="◀ 上一张"
                        Width="80" Height="35"
                        Click="PrevImage1_Click"
                        FontSize="14" Margin="0,0,0,10"/>
                <Button Content="下一张 ▶"
                        Width="80" Height="35"
                        Click="NextImage1_Click"
                        FontSize="14"/>
            </StackPanel>

            <GridSplitter Grid.Row="1" Grid.ColumnSpan="3" Height="4" Background="Gray"
                          HorizontalAlignment="Stretch" />

            <!-- 算法2：相机2 原始 + 检测 -->
            <GroupBox Grid.Row="2" Grid.Column="0" Header="相机2 - 原始图像" Foreground="White"
                      BorderBrush="Gray" Margin="0,5,5,0">
                <Image x:Name="Cam2Original"
                       Stretch="Uniform"
                       Source="{x:Null}"/>
            </GroupBox>

            <GroupBox Grid.Row="2" Grid.Column="1" Header="相机2 - 算法2检测" Foreground="White"
                      BorderBrush="Gray" Margin="5,5,0,0">
                <Image x:Name="Cam2Detection"
                       Stretch="Uniform"
                       Source="{x:Null}"/>
            </GroupBox>

            <StackPanel Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Margin="10,5,0,0">
                <Button Content="◀ 上一张"
                        Width="80" Height="35"
                        Click="PrevImage2_Click"
                        FontSize="14" Margin="0,0,0,10"/>
                <Button Content="下一张 ▶"
                        Width="80" Height="35"
                        Click="NextImage2_Click"
                        FontSize="14"/>
            </StackPanel>
        </Grid>

        <!-- 底部：状态指示 + 日志显示区域（固定高度，不挤占图像区域） -->
        <Grid Grid.Row="2" Margin="0,10,0,0" Height="160">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,6">
                <Ellipse x:Name="ConnectionLight"
                         Width="16" Height="16"
                         Fill="Red" Stroke="White" StrokeThickness="1"
                         VerticalAlignment="Center"/>
                <TextBlock x:Name="ConnectionStatusText"
                           Text="PLC 未连接"
                           Foreground="White" FontSize="14"
                           Margin="8,0,30,0"
                           VerticalAlignment="Center"/>
                <Ellipse x:Name="HeartbeatLight"
                         Width="16" Height="16"
                         Fill="#14401A" Stroke="White" StrokeThickness="1"
                         VerticalAlignment="Center"/>
                <TextBlock Text="心跳"
                           Foreground="White" FontSize="14"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <GroupBox Grid.Row="1" Header="运行日志" Foreground="White"
                      BorderBrush="Gray">
                <RichTextBox x:Name="LogRichTextBox"
                             Background="#1A1A1A"
                             Foreground="White"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12" />
            </GroupBox>
        </Grid>
    </Grid>
</Window>
