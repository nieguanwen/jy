<Window x:Class="thread_burr_cleaning.CameraConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="相机配置" Height="520" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 相机序列号 -->
        <GroupBox Grid.Row="0" Header="相机序列号（USB）" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="左相机SN：" VerticalAlignment="Center" Margin="0,6"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="LCameraSnBox"
                          IsEditable="True" Margin="0,6" Height="25"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="右相机SN：" VerticalAlignment="Center" Margin="0,6"/>
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="RCameraSnBox"
                          IsEditable="True" Margin="0,6" Height="25"/>

                <Button Grid.Row="2" Grid.Column="1" Content="刷新设备列表"
                        Width="110" Height="26" HorizontalAlignment="Right"
                        Margin="0,8,0,2" Click="RefreshDevicesButton_Click"/>
            </Grid>
        </GroupBox>

        <!-- 采集参数（左右独立） -->
        <TabControl Grid.Row="1" Margin="0,10,0,0">
            <TabItem Header="左相机采集参数">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="曝光(us)：" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="LExposureBox" Margin="0,5" Height="25"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="增益(dB)：" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="LGainBox" Margin="0,5" Height="25"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="间隔时间(ms)：" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="LIntervalBox" Margin="0,5" Height="25"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="ROI_X：" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="LRoiXBox" Margin="0,5" Height="25"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="ROI_Y：" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="LRoiYBox" Margin="0,5" Height="25"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="ROI宽：" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="LRoiWidthBox" Margin="0,5" Height="25"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="ROI高：" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="6" Grid.Column="1" x:Name="LRoiHeightBox" Margin="0,5" Height="25"/>
                </Grid>
            </TabItem>

            <TabItem Header="右相机采集参数">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="曝光(us)：" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="RExposureBox" Margin="0,5" Height="25"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="增益(dB)：" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="RGainBox" Margin="0,5" Height="25"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="间隔时间(ms)：" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="RIntervalBox" Margin="0,5" Height="25"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="ROI_X：" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="RRoiXBox" Margin="0,5" Height="25"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="ROI_Y：" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="RRoiYBox" Margin="0,5" Height="25"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="ROI宽：" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="RRoiWidthBox" Margin="0,5" Height="25"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="ROI高：" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="6" Grid.Column="1" x:Name="RRoiHeightBox" Margin="0,5" Height="25"/>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,15,0,0">
            <Button Content="确定" Width="80" Height="30" Click="OkButton_Click" Margin="0,0,10,0"/>
            <Button Content="取消" Width="80" Height="30" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
