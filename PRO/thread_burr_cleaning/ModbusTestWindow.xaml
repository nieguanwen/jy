<Window x:Class="thread_burr_cleaning.ModbusTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLC通讯测试" Height="620" Width="1200"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style TargetType="TextBox" x:Key="TestTextBox">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 连接栏 -->
        <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="PLC IP:"/>
                <TextBox x:Name="txtIP" Text="172.16.129.137" Width="130" Style="{StaticResource TestTextBox}"/>
                <TextBlock Text="端口:"/>
                <TextBox x:Name="txtPort" Text="502" Width="60" Style="{StaticResource TestTextBox}"/>
                <Button x:Name="btnConnect" Content="连接PLC" Width="90"
                        Click="btnConnect_Click" Margin="10,2,2,2"/>
                <Button x:Name="btnDisconnect" Content="断开" Width="70"
                        Click="btnDisconnect_Click" IsEnabled="False"/>
                <TextBlock x:Name="txtStatus" Text="未连接" Foreground="Red"
                           FontWeight="Bold" Margin="15,0,0,0" VerticalAlignment="Center"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：PLC Modbus通讯测试 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="PLC Modbus通讯测试" FontWeight="Bold" FontSize="20" Margin="0,0,0,10"/>

                <Grid Grid.Row="1" IsEnabled="{Binding IsConnected}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="类型" Grid.Row="0" Grid.Column="0" FontWeight="Bold"/>
                    <TextBlock Text="地址" Grid.Row="0" Grid.Column="1" FontWeight="Bold"/>
                    <TextBlock Text="读取" Grid.Row="0" Grid.Column="2" FontWeight="Bold"/>
                    <TextBlock Text="发送地址" Grid.Row="0" Grid.Column="4" FontWeight="Bold"/>
                    <TextBlock Text="发送值" Grid.Row="0" Grid.Column="5" FontWeight="Bold"/>
                    <TextBlock Text="写入" Grid.Row="0" Grid.Column="6" FontWeight="Bold"/>

                    <!-- int -->
                    <TextBlock Text="int" Grid.Row="1" Grid.Column="0"/>
                    <TextBox x:Name="txtReadIntAddr" Grid.Row="1" Grid.Column="1" Style="{StaticResource TestTextBox}"/>
                    <Button x:Name="btnReadInt" Content="读取int" Grid.Row="1" Grid.Column="2" Click="btnReadInt_Click"/>
                    <TextBox x:Name="txtWriteIntAddr" Grid.Row="1" Grid.Column="4" Style="{StaticResource TestTextBox}"/>
                    <TextBox x:Name="txtWriteIntVal" Grid.Row="1" Grid.Column="5" Style="{StaticResource TestTextBox}"/>
                    <Button x:Name="btnWriteInt" Content="写入int" Grid.Row="1" Grid.Column="6" Click="btnWriteInt_Click"/>

                    <!-- float -->
                    <TextBlock Text="float" Grid.Row="2" Grid.Column="0"/>
                    <TextBox x:Name="txtReadFloatAddr" Grid.Row="2" Grid.Column="1" Style="{StaticResource TestTextBox}"/>
                    <Button x:Name="btnReadFloat" Content="读取float" Grid.Row="2" Grid.Column="2" Click="btnReadFloat_Click"/>
                    <TextBox x:Name="txtWriteFloatAddr" Grid.Row="2" Grid.Column="4" Style="{StaticResource TestTextBox}"/>
                    <TextBox x:Name="txtWriteFloatVal" Grid.Row="2" Grid.Column="5" Style="{StaticResource TestTextBox}"/>
                    <Button x:Name="btnWriteFloat" Content="写入float" Grid.Row="2" Grid.Column="6" Click="btnWriteFloat_Click"/>

                    <!-- bool -->
                    <TextBlock Text="bool" Grid.Row="3" Grid.Column="0"/>
                    <TextBox x:Name="txtReadBoolAddr" Grid.Row="3" Grid.Column="1" Style="{StaticResource TestTextBox}"/>
                    <Button x:Name="btnReadBool" Content="读取bool" Grid.Row="3" Grid.Column="2" Click="btnReadBool_Click"/>
                    <TextBox x:Name="txtWriteBoolAddr" Grid.Row="3" Grid.Column="4" Style="{StaticResource TestTextBox}"/>
                    <ComboBox x:Name="cmbWriteBoolVal" Grid.Row="3" Grid.Column="5" Width="100" VerticalAlignment="Center" Margin="5">
                        <ComboBoxItem Content="True" IsSelected="True"/>
                        <ComboBoxItem Content="False"/>
                    </ComboBox>
                    <Button x:Name="btnWriteBool" Content="写入bool" Grid.Row="3" Grid.Column="6" Click="btnWriteBool_Click"/>

                    <!-- 快捷信号 -->
                    <TextBlock Text="信号" Grid.Row="4" Grid.Column="0"/>
                    <ComboBox x:Name="cmbSignalNames" Grid.Row="4" Grid.Column="1" Width="110" VerticalAlignment="Center" Margin="5"/>
                    <Button x:Name="btnReadSignal" Content="读取信号" Grid.Row="4" Grid.Column="2" Click="btnReadSignal_Click"/>
                </Grid>

                <!-- 二级通讯(SecondComm)测试 -->
                <TextBlock Grid.Row="2" Text="二级通讯测试 (apitagCSx64)" FontWeight="Bold" FontSize="20" Margin="0,10,0,5"/>

                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="类型" Grid.Row="0" Grid.Column="0" FontWeight="Bold"/>
                    <TextBlock Text="表名" Grid.Row="0" Grid.Column="1" FontWeight="Bold"/>
                    <TextBlock Text="标签名" Grid.Row="0" Grid.Column="2" FontWeight="Bold"/>
                    <TextBlock Text="读取" Grid.Row="0" Grid.Column="3" FontWeight="Bold"/>
                    <TextBlock Text="写入值" Grid.Row="0" Grid.Column="5" FontWeight="Bold"/>
                    <TextBlock Text="写入" Grid.Row="0" Grid.Column="6" FontWeight="Bold"/>

                    <TextBlock Text="float" Grid.Row="1" Grid.Column="0"/>
                    <TextBox x:Name="txtSecTable" Grid.Row="1" Grid.Column="1" Style="{StaticResource TestTextBox}" Text="ISI_SCAN_DATA"/>
                    <TextBox x:Name="txtSecTag" Grid.Row="1" Grid.Column="2" Style="{StaticResource TestTextBox}"/>
                    <Button x:Name="btnSecRead" Content="读取float" Grid.Row="1" Grid.Column="3" Click="btnSecRead_Click"/>
                    <TextBox x:Name="txtSecWriteVal" Grid.Row="1" Grid.Column="5" Style="{StaticResource TestTextBox}"/>
                    <Button x:Name="btnSecWrite" Content="写入float" Grid.Row="1" Grid.Column="6" Click="btnSecWrite_Click"/>
                </Grid>
            </Grid>

            <!-- 右侧：结果显示 -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="通讯结果:" FontSize="15">
                    <TextBox x:Name="txtResult" VerticalScrollBarVisibility="Visible"
                             TextWrapping="Wrap" FontSize="13"
                             IsReadOnly="True" Background="#F5F5F5"/>
                </GroupBox>

                <Button x:Name="btnClear" Content="清空" Grid.Row="1"
                        HorizontalAlignment="Right" Width="80"
                        Click="btnClear_Click" Margin="0,5,0,0"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
